# LLM via Ollama
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=gemma3:4b   # or gemma2:4b, update to your local tag

# TTS options:
# Choose one:
# TTS_PROVIDER=elevenlabs or piper
TTS_PROVIDER=piper

# IF TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY= 
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2

# IF TTS_PROVIDER=piper
PIPER_EXECUTABLE=./bin/piper/piper.exe    # Ensure in PATH or put absolute path
PIPER_VOICE=./bin/en_US-hfc_female-medium.onnx
# Audio sample rate and format settings are managed internally.

# Rhubarb lipsync
RHUBARB_PATH=./bin/rhubarb/rhubarb.exe

# Optional server config
HOST=0.0.0.0
PORT=8000